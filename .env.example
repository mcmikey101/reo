# Образец переменных окружения reo (docs/conventions.md, раздел 3).
# Скопируйте в .env и поменяйте нужное: cp .env.example .env
# Файл .env в git не коммитим. Без .env docker compose берёт значения ниже по умолчанию.

# --- БД (сервис db) ---
POSTGRES_USER=reo
# Пароль подставляется в строку подключения: без символов @ : / ? #
POSTGRES_PASSWORD=reo
POSTGRES_DB=reo
# Порт БД на вашем компьютере. Поменяйте, если 5432 занят локальным PostgreSQL
POSTGRES_PORT=5432

# --- Фронтенд (сервис fe) ---
# Адрес API для браузера
VITE_API_URL=http://localhost:8000

# --- Только для запуска api вне Docker ---
# docker compose эти две строки не читает: внутри Docker api получает
# DATABASE_URL с хостом db и ML_URL=http://ml:8001 из docker-compose.yml.
# При запуске вне Docker задайте их в терминале (см. be/README.md).
DATABASE_URL=postgresql://reo:reo@localhost:5432/reo
ML_URL=http://localhost:8001
